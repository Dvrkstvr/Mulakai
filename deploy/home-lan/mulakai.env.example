# /etc/mulakai.env — read by mulakai.service. LAN only: the API has no auth.
HOST=0.0.0.0
PORT=3001
DATA_DIR=/var/lib/mulakai
CLIENT_DIST=/opt/mulakai/client/dist
AUDIO_DIR=/srv/mulakai-audio   # the data-disk bind mount (README.md); unset = $DATA_DIR/audio

# Engines run on the GPU PC (192.168.2.42). Each must listen on the LAN and be
# let through the Windows Firewall from this container's IP before jobs work.
ACESTEP_API_URL=http://192.168.2.42:8001
# ACESTEP_API_KEY=
# YUE_API_URL=http://192.168.2.42:8004
# YUE_API_KEY=
# LLM_API_URL=http://192.168.2.42:11434
# DEMUCS_API_URL=http://192.168.2.42:8002
# LYRICS_API_URL=http://192.168.2.42:8005
