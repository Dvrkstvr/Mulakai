    ],
    "lyrics": [
     {
      "tag": "Verse",
      "lines": [
       "Der Nebel liegt schwer auf dem Gleis",
       "Die Welt wird so leise und still",
       "Ich sehe dein Gesicht im fahlen Licht",
       "Und weiß nicht, was ich jetzt sagen will",
       "Nur der kalte Wind weht durch die Nacht"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Der Zug fährt langsam davon",
       "Und lässt mich hier einsam zurück",
       "Dein Abschied ist ein schwerer Ton",
       "Ein letzter, trauriger Augenblick",
       "In meinem Herzen bleibt nur die Leere"
      ]
     },
     {
      "tag": "Verse",
      "lines": [
       "Die Schienen führen weit in die Ferne",
       "Wo du nun dein neues Leben beginnst",
       "Ich halte noch fest an der Erinnerung",
       "Während die Zeit so unerbittlich rinnt",
       "Und die Lichter der Stadt langsam verblassen"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Der Zug fährt langsam davon",
       "Und lässt mich hier einsam zurück",
       "Dein Abschied ist ein schwerer Ton",
       "Ein letzter, trauriger Augenblick",
       "In meinem Herzen bleibt nur die Leere"
      ]
     },
     {
      "tag": "Bridge",
      "lines": [
       "Ich wollte die Zeit einfach anhalten",
       "Dich noch einmal ganz fest halten",
       "Doch das Schicksal hat seinen eigenen Plan",
       "Und lässt uns nicht mehr zusammen sein"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Der Zug fährt langsam davon",
       "Und lässt mich hier einsam zurück",
       "Dein Abschied ist ein schwerer Ton",
       "Ein letzter, trauriger Augenblick",
       "In meinem Herzen bleibt nur die Leere"
      ]
     },
     {
      "tag": "Outro",
      "lines": [
       "Nur noch die Stille am Bahnsteig",
       "Nur noch der Regen auf dem Stein",
       "Du bist fort, und ich bleibe hier",
       "Ganz allein"
      ]
     }
    ],
