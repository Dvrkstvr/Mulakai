    ],
    "lyrics": [
     {
      "tag": "Verse",
      "lines": [
       "Der Regen fällt auf das kalte Glas",
       "Ich seh dein Gesicht im Nebel ganz blass",
       "Der Bahnsteig ist leer und die Welt steht still",
       "Nur das Echo der Schritte, das ich noch will"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Und der Zug fährt langsam davon",
       "Verliert uns im fahlen Mondschein-Lohn",
       "Ein letzter Gruß, ein letzter Blick",
       "Es gibt kein Halten, kein Zurück"
      ]
     },
     {
      "tag": "Verse",
      "lines": [
       "Dein Koffer steht schwer auf dem grauen Stein",
       "Ich fühl mich so einsam und so allein",
       "Die Anzeigetafel zeigt die Zeit an",
       "Ein Ende beginnt, das niemand begann"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Und der Zug fährt langsam davon",
       "Verliert uns im fahlen Mondschein-Lohn",
       "Ein letzter Gruß, ein letzter Blick",
       "Es gibt kein Halten, kein Zurück"
      ]
     },
     {
      "tag": "Bridge",
      "lines": [
       "Die Schienen führen weit in die Nacht",
       "Ich hab an das Morgen nicht mehr gedacht",
       "Nur die Stille bleibt hier bei mir zurück",
       "Ein zerbrochenes, leises Glück"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Und der Zug fährt langsam davon",
       "Verliert uns im fahlen Mondschein-Lohn",
       "Ein letzter Gruß, ein letzter Blick",
       "Es gibt kein Halten, kein Zurück"
      ]
     },
     {
      "tag": "Outro",
      "lines": [
       "Nur noch der Regen am Fensterglas",
       "Alles wird leise, alles wird blass",
       "Nur noch der Regen",
       "Nur noch die Nacht"
      ]
     }
    ],
