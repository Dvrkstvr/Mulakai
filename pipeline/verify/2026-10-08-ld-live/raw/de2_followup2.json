    "lyrics": [
     {
      "tag": "Verse",
      "lines": [
       "Der Regen fällt auf das kalte Glas",
       "Ich sehe dein Gesicht im Nebel kaum",
       "Die Zeit steht still, doch der Zug fährt ab",
       "Ein letzter Blick, ein schwerer Traum"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Alles geht vorbei, alles muss vergehen",
       "Nur die Erinnerung wird bei uns bestehen",
       "Abschied am Bahnhof, die Welt bleibt leer",
       "Ohne dich fällt das Atmen so schwer"
      ]
     },
     {
      "tag": "Verse",
      "lines": [
       "Die Gleise glänzen im fahlen Licht",
       "Dein Abschiedsgruß verhallt im Wind",
       "Ich halte fest, was ich noch nicht verliere",
       "Während wir beide nun Fremde sind"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Alles geht vorbei, alles muss vergehen",
       "Nur die Erinnerung wird bei uns bestehen",
