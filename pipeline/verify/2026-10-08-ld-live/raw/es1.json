   "fields": {
    "title": "Balada del Mar",
    "style": "ballad, acoustic guitar, strings, melancholic, female voice",
    "bpm": 60,
    "key": "Am",
    "timeSignature": "4/4",
    "language": "es",
    "structure": [
     "Intro",
     "Verse",
     "Chorus",
     "Verse",
     "Chorus",
     "Bridge",
     "Chorus",
     "Outro"
    ],
    "lyrics": [
     {
      "tag": "Verse",
      "lines": [
       "En la orilla del tiempo, donde el viento susurra",
       "El mar me canta historias que no puedo olvidar",
       "Con sus olas suaves, como un beso de despedida",
       "Lleva mi alma lejos, hacia un horizonte frío"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Balada del mar, tu voz me llama en la noche",
       "Con cada latido, me haces sentir la nostalgia",
       "Balada del mar, en tus aguas me he perdido",
       "Y en tus brazos, encuentro un amor que no es mío"
      ]
     },
     {
      "tag": "Verse",
      "lines": [
       "Las estrellas brillan sobre el agua plateada",
       "Como recuerdos que no puedo alcanzar",
       "El barco se aleja, con su bandera en alto",
       "Y en mi corazón, queda un eco de su canto"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Balada del mar, tu voz me llama en la noche",
       "Con cada latido, me haces sentir la nostalgia",
       "Balada del mar, en tus aguas me he perdido",
       "Y en tus brazos, encuentro un amor que no es mío"
      ]
     },
     {
      "tag": "Bridge",
      "lines": [
       "A veces pienso que el mar es un gran poeta",
       "Que escribe versos con cada ola que rompe",
       "Y en sus profundidades, hay secretos que guardo",
       "Que solo el viento y la luna pueden entender"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Balada del mar, tu voz me llama en la noche",
       "Con cada latido, me haces sentir la nostalgia",
       "Balada del mar, en tus aguas me he perdido",
       "Y en tus brazos, encuentro un amor que no es mío"
      ]
     },
     {
      "tag": "Outro",
      "lines": [
       "El mar sigue cantando, aunque ya no esté aquí",
       "Y en mi alma, su canción nunca se irá",
       "Balada del mar, en tu voz me quedo atrapado",
       "Hasta que el tiempo me lleve a tu abrazo"
      ]
     }
    ],
    "engine": "yue2"
