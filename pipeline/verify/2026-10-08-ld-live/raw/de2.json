    "lyrics": [
     {
      "tag": "Verse",
      "lines": [
       "Der Nebel liegt schwer auf dem Gleis",
       "Die Welt wird ganz leise und still",
       "Ich sehe dein Gesicht im kalten Licht",
       "Und weiß nicht, was ich heute noch will",
       "Nur der Wind weht durch mein Haar"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Der Zug fährt langsam davon",
       "Und lässt mich hier einsam zurück",
       "Dein Abschied ist wie ein tiefer Schmerz",
       "Ein letzter, trauriger Augenblick",
       "Nur die Schienen bleiben weit"
      ]
     },
     {
      "tag": "Verse",
      "lines": [
       "Deine Hand entgleitet meiner Hand",
       "Ein letztes Mal berühren wir uns kurz",
       "Der Dampf steigt auf wie ein leises Gebet",
       "Und die Sehnsucht wird unendlich groß",
       "Ich sehe nur noch die leere Bahn"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Der Zug fährt langsam davon",
       "Und lässt mich hier einsam zurück",
       "Dein Abschied ist wie ein tiefer Schmerz",
       "Ein letzter, trauriger Augenblick",
       "Nur die Schienen bleiben weit"
      ]
     },
     {
      "tag": "Bridge",
      "lines": [
       "Die Lichter der Stadt verblassen im Grau",
       "Ich bleibe am Bahnsteig allein",
       "Jeder Herzschlag fühlt sich so schwer an",
       "Es wird niemals wieder so sein"
      ]
     },
     {
      "tag": "Chorus",
      "lines": [
       "Der Zug fährt langsam davon",
       "Und lässt mich hier einsam zurück",
       "Dein Abschied ist wie ein tiefer Schmerz",
       "Ein letzter, trauriger Augenblick",
       "Nur die Schienen bleiben weit"
      ]
     },
     {
      "tag": "Outro",
      "lines": [
       "Nur noch Stille am Bahnhof",
       "Nur noch Schatten im Licht",
       "Die Zeit steht für mich still",
       "Ich vergesse dein Gesicht nicht"
      ]
     }
